# ─── API Gateway ──────────────────────────────────────────────────────────────
# URL of the API Gateway (K8s NodePort or local docker-compose)
NEXT_PUBLIC_API_URL=http://localhost:30080

# ─── Mock Mode ────────────────────────────────────────────────────────────────
# Set to "true" to use the built-in mock data without a running backend.
# Set to "false" to hit the real microservices via the API Gateway.
NEXT_PUBLIC_MOCK_MODE=true

# ─── Observability Stack URLs ─────────────────────────────────────────────────
# These are used on the /observability page (admin only).
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
NEXT_PUBLIC_KIBANA_URL=http://localhost:5601
NEXT_PUBLIC_RABBITMQ_URL=http://localhost:15672
