{
  "title": "User Service",
  "uid": "user-service-dashboard",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"user-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"user-service\",status=~\"5..\"}[5m])",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m]))",
          "legendFormat": "P99 {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"ERROR\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Warn Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"WARN\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "All Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
