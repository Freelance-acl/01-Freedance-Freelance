{
  "title": "User Service",
  "uid": "user-service-dashboard",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"user-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"user-service\",status=~\"5..\"}[5m])",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m]))",
          "legendFormat": "P99 {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"ERROR\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Warn Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"WARN\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "All Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM Memory Used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_used_bytes{job=\"user-service\"}",
          "legendFormat": "{{area}} {{id}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "process_cpu_usage{job=\"user-service\"}",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 9,
      "title": "Published User Events",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"Published event\" |= \"user.\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 10,
      "title": "Failed User Event Publishing",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"Failed to publish event\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 11,
      "title": "Proposal Completed Consumer Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"proposal.completed\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 12,
      "title": "Proposal Cancelled Consumer Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |= \"proposal.cancelled\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 13,
      "title": "Freelancer Stats Updates",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |~ \"Updated freelancer stats|Reversed freelancer stats\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 14,
      "title": "Duplicate / Unsupported Event Handling",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"user-service\"} |~ \"Ignoring duplicate proposal.completed|Ignoring unsupported event\"",
          "legendFormat": ""
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
