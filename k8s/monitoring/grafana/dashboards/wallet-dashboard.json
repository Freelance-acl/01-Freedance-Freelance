{
  "title": "Wallet Service",
  "uid": "wallet-service-dashboard",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"wallet-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Payout Processing Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"wallet-service\",uri=~\".*/payouts.*\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"wallet-service\"}[5m]))",
          "legendFormat": "P99 {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"wallet-service\"} |= \"ERROR\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Payment Event Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"wallet-service\"} |= \"payment\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "All Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"wallet-service\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "title": "Feign Call Outcomes (S5-F3/S5-F10)",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"freelance\", service=\"wallet-service\"} |= \"Feign\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "title": "Freelancer Payout Total Requests",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"freelance\", service=\"wallet-service\"} |= \"/total\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "title": "Category Analytics Slow Operations",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"freelance\", service=\"wallet-service\"} |= \"ANALYTICS_VIEWED\"",
          "legendFormat": ""
        }
      ]
    }
  ]
}
