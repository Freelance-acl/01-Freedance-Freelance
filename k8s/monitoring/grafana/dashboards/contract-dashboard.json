{
  "title": "Contract Service",
  "uid": "contract-service-dashboard",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"contract-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"contract-service\",status=~\"[45]..\"}[5m])",
          "legendFormat": "{{status}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM GC Pause Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"contract-service\"}[5m])",
          "legendFormat": "GC {{action}} {{cause}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"contract-service\"} |= \"ERROR\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Cassandra Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"contract-service\"} |= \"cassandra\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "All Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"contract-service\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
