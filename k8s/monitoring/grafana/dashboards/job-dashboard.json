{
  "title": "Job Service",
  "uid": "job-service-dashboard",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"job-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{job=\"job-service\",status=~\"5..\"}[5m])",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "S2-F12 Dashboard Cache Hit Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(cache_gets_total{job=\"job-service\",cache=\"S2-F12\",result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_gets_total{job=\"job-service\",cache=\"S2-F12\"}[5m])), 1)",
          "legendFormat": "S2-F12 hit ratio"
        }
      ]
    },
    {
      "id": 7,
      "title": "RabbitMQ Job Saga Listener Depth",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_queue_messages_ready{queue=\"job.proposal.saga-listener\"}",
          "legendFormat": "ready"
        },
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_queue_messages_unacked{queue=\"job.proposal.saga-listener\"}",
          "legendFormat": "unacked"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"job-service\"} |= \"ERROR\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Elasticsearch Query Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"job-service\"} |= \"elasticsearch\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "All Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"job-service\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
