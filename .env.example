# Database Configuration (placeholders - DO NOT commit real secrets)
# Copy this file to `.env` and fill in real values locally.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=freelancedb
# JDBC URL: use jdbc:postgresql://localhost:5432/freelancedb for local run; postgres hostname in Docker Compose
DB_URL=jdbc:postgresql://localhost:5432/freelancedb
DB_PASS=postgres

# Service Ports (external mappings)
USER_SERVICE_PORT=8081
JOB_SERVICE_PORT=8082
PROPOSAL_SERVICE_PORT=8083
CONTRACT_SERVICE_PORT=8084
WALLET_SERVICE_PORT=8085

# Docker Internal Service Port (container port for all services)
INTERNAL_SERVICE_PORT=8080

# JWT signing key (required for all Spring services). Base64, ≥32 bytes when decoded (e.g. openssl rand -base64 32).
# Do not commit a real value; copy to .env and set locally / in CI secrets.
JWT_SECRET=dGhpcyBpcyBhIHNlY3JldCBrZXkgZm9yIEpXVCBzaWduaW5n

# NoSQL — §6 Database Architecture (localhost when running services on host; Docker hostnames in compose)
SPRING_DATA_MONGODB_URI=mongodb://root:rootpass@localhost:27017/freelancemongo?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
ELASTICSEARCH_URIS=http://localhost:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpass
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=freelanceks
