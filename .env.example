# Database Configuration (placeholders - DO NOT commit real secrets)
# Copy this file to `.env` and fill in real values locally.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# JDBC URL: use jdbc:postgresql://localhost:5432/freelancedb for local run; postgres hostname in Docker Compose
DB_URL=
DB_USER=
DB_PASS=

# Service Ports (external mappings)
USER_SERVICE_PORT=8081
JOB_SERVICE_PORT=8082
PROPOSAL_SERVICE_PORT=8083
CONTRACT_SERVICE_PORT=8084
WALLET_SERVICE_PORT=8085

# Docker Internal Service Port (container port for all services)
INTERNAL_SERVICE_PORT=8080

# JWT signing key (required for all Spring services). Base64, ≥32 bytes when decoded (e.g. openssl rand -base64 32).
# Do not commit a real value; copy to .env and set locally / in CI secrets.
JWT_SECRET=
