#!/bin/sh
# Branch naming and mvn test checks for milestone feature work.
# Milestone 3 branch format: <type>/M3/<scope>/<descriptor>/<studentId>
#   e.g. feat/M3/wallet/S5-F12/13000892
# Commit message format (see commit-msg hook): <type>(<scope>): <subject> (<studentId>)

set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

ALLOWED_TYPES='feat|fix|hotfix|refactor|docs|test|chore|perf'
ALLOWED_SCOPES='user|job|proposal|contract|wallet|m1|cc|infra'
ALLOWED_SERVICE_SCOPES='user-service|job-service|proposal-service|contract-service|wallet-service'
ALLOWED_DESCRIPTOR='(S[1-5]-F[1-9][0-9]*|MOD-[0-9]+|CC-[0-9]+|DP-[1-7]|[a-z0-9]+(-[a-z0-9]+)*)'

validate_branch() {
  b=$1

  case "$b" in
    main|master)
      return 0
    ;;
    feat/docker/*)
      rest=${b#feat/docker/}
      if [ -z "$rest" ]; then
        echo "pre-push: feat/docker/<studentId> must include an id segment." >&2
        return 1
      fi
      case "$rest" in
        */*)
          echo "pre-push: feat/docker must be exactly feat/docker/<studentId>, got: $b" >&2
          return 1
        ;;
      esac
      if ! printf '%s' "$rest" | grep -Eq '^[0-9]+$'; then
        echo "pre-push: feat/docker/<studentId> must use digits only, got: $b" >&2
        return 1
      fi
      return 0
    ;;
  esac

  if ! printf '%s' "$b" | grep -Eq "^($ALLOWED_TYPES)/"; then
    echo "pre-push: branch type must be one of: feat, fix, hotfix, refactor, docs, test, chore, perf; got: $b" >&2
    return 1
  fi

  nf=$(printf '%s' "$b" | awk -F/ '{print NF}')
  if [ "$nf" -ne 5 ]; then
    echo "pre-push: branch must be <type>/M3/<scope>/<descriptor>/<studentId>, got: $b" >&2
    return 1
  fi

  milestone=$(printf '%s' "$b" | cut -d/ -f2)
  scope=$(printf '%s' "$b" | cut -d/ -f3)
  descriptor=$(printf '%s' "$b" | cut -d/ -f4)
  id=$(printf '%s' "$b" | cut -d/ -f5)

  if [ "$milestone" != "M3" ]; then
    echo "pre-push: milestone segment must be 'M3' (e.g. feat/M3/wallet/S5-F12/13000892), got: $milestone" >&2
    return 1
  fi

  if ! printf '%s' "$scope" | grep -Eq "^($ALLOWED_SCOPES|$ALLOWED_SERVICE_SCOPES)$"; then
    echo "pre-push: invalid branch scope; expected one of user, job, proposal, contract, wallet, m1, cc, infra (service-name aliases accepted); got: $scope" >&2
    return 1
  fi

  if ! printf '%s' "$descriptor" | grep -Eq "^$ALLOWED_DESCRIPTOR$"; then
    echo "pre-push: invalid branch descriptor; use S#-F#, MOD-#, CC-#, DP-#, or kebab-case: $descriptor" >&2
    return 1
  fi

  if ! printf '%s' "$id" | grep -Eq '^[0-9]+$'; then
    echo "pre-push: branch student ID must be digits only: $id" >&2
    return 1
  fi

  return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue

  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac

  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  branch=${local_ref#refs/heads/}

  validate_branch "$branch" || exit 1
 done

if [ "$SKIP_TESTS" = "1" ] || [ "$NO_VERIFY" = "1" ]; then
  echo "pre-push: skipping mvn test (SKIP_TESTS=1 or NO_VERIFY=1)." >&2
  exit 0
fi

# Maven uses JAVA_HOME for javac. PATH may point at Java 25 while JAVA_HOME is still JDK 20,
# which breaks --release 25. Prefer JDK 25 when JAVA_HOME is missing or not 25.
prefer_java25_for_maven() {
  maj=""
  if [ -n "${JAVA_HOME}" ] && [ -x "${JAVA_HOME}/bin/javac" ]; then
    maj=$("${JAVA_HOME}/bin/javac" -version 2>&1 | tr -d '\015' | awk 'NR==1{split($2,a,".");print a[1]}')
  fi
  if [ "$maj" = "25" ]; then
    return 0
  fi
  for p in \
    "/c/Program Files/Java/jdk-25" \
    "/c/Program Files/Java/jdk-25.0.2" \
    "/c/Program Files/Eclipse Adoptium/jdk-25.0.2.10-hotspot" \
    "/usr/lib/jvm/java-25-openjdk-amd64" \
    "/usr/lib/jvm/temurin-25-jdk-amd64"
  do
    [ -x "$p/bin/javac" ] || continue
    v=$("$p/bin/javac" -version 2>&1 | tr -d '\015' | awk 'NR==1{split($2,a,".");print a[1]}')
    if [ "$v" = "25" ]; then
      export JAVA_HOME="$p"
      export PATH="$JAVA_HOME/bin:$PATH"
      echo "pre-push: JAVA_HOME -> $JAVA_HOME (JDK 25 for Maven)." >&2
      return 0
    fi
  done
  echo "pre-push: warning: JDK 25 not detected in JAVA_HOME or common paths; mvn may fail with release 25 not supported." >&2
}

prefer_java25_for_maven

run_mvn_test() {
  if [ -x "$ROOT/mvnw" ]; then
    "$ROOT/mvnw" -q test-compile test
  elif [ -f "$ROOT/mvnw" ]; then
    sh "$ROOT/mvnw" -q test-compile test
  elif command -v mvn >/dev/null 2>&1; then
    mvn -q test-compile test
  else
    echo "pre-push: neither ./mvnw nor mvn found; cannot run tests." >&2
    return 1
  fi
}

echo "pre-push: running tests for all modules..." >&2
run_mvn_test || {
  echo "pre-push: mvn test failed." >&2
  exit 1
}

exit 0
