#!/bin/sh
# Enforce project commit message convention with numeric student IDs.

MSG_FILE=${1:-}
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg: missing message file." >&2
  exit 1
fi

MSG=$(cat "$MSG_FILE")
FIRST=$(printf '%s\n' "$MSG" | sed -n '1p' | tr -d '\015')
case "$FIRST" in
  Merge\ *) exit 0 ;;
  Revert\ *) exit 0 ;;
esac

case "$FIRST" in
  init:\ project\ setup\ by\ *) exit 0 ;;
esac

if echo "$FIRST" | grep -Eq '^(feat|fix|hotfix|refactor|docs|test|chore|perf)\((user|job|proposal|contract|wallet|user-service|job-service|proposal-service|contract-service|wallet-service|m1|cc|infra)\): .+ \([0-9]+\)$'; then
  exit 0
fi

echo "commit-msg: message must match the project commit convention:" >&2
echo "  <type>(<scope>): <subject> (<studentId>)" >&2
echo "Types: feat, fix, hotfix, refactor, docs, test, chore, perf" >&2
echo "Scopes: user, job, proposal, contract, wallet, m1, cc, infra" >&2
echo "Service-name aliases user-service/job-service/... are also accepted." >&2
echo "Student ID must be digits only, e.g. 13000892" >&2
echo "Also allowed: Merge ... / Revert ... / init: project setup by (...)" >&2
echo "First line was: $FIRST" >&2
exit 1
